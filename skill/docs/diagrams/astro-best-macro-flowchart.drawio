        <mxCell id="node_d6" value="&lt;b&gt;⑥ smss_dr4: SMSS DR4 定标星表&lt;/b&gt; &amp;nbsp;&lt;span style='color:#2563EB;'&gt;[DRIVER]&lt;/span&gt;&lt;br/&gt;&lt;span style='font-size:10.5px;color:#64748B;'&gt;smss_dr4/q | SkyMapper 南天巡天基准&lt;/span&gt;&lt;br/&gt;&lt;hr style='border:0.5px solid #CBD5E1;'/&gt;• &lt;b&gt;核心测光&lt;/b&gt;: &lt;code&gt;smss_dr4_psf_mag, source_id&lt;/code&gt;&lt;br/&gt;• &lt;b&gt;科学定位&lt;/b&gt;: 覆盖南半球天区的主力光学测光定标星表" style="whiteSpace=wrap;html=1;fontFamily=Segoe UI,Microsoft YaHei,PingFang SC,sans-serif;rounded=1;arcSize=6;fillColor=#EEF2FF;fontColor=#3730A3;strokeColor=#4F46E5;strokeWidth=1.8;fontSize=11.5;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=10;spacingBottom=10;" vertex="1" parent="s4_catalogs">
