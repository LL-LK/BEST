# Git LFS 追踪规则（>50MB 的文件走 LFS，其余走普通 git 对象）

*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
reproduction/03_数据_E1-E6/E2/code/statcatalog/*.csv filter=lfs diff=lfs merge=lfs -text
skill/statcatalog/*.csv filter=lfs diff=lfs merge=lfs -text

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.docx binary
*.gz binary
*.zip binary
