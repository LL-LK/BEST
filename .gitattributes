# Git LFS rules (>50MB archives & large tables)
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.zip filter=lfs diff=lfs merge=lfs -text
skill/statcatalog/*.csv filter=lfs diff=lfs merge=lfs -text

# Binary files without EOL conversion
*.png binary
*.jpg binary
*.pdf binary
*.xlsx binary
*.docx binary
*.gz binary
*.zip binary

# Preserve exact bytes for vector SVGs and frozen release artifacts
/reproduction/figures/*.svg -text -diff
/reproduction/releases/** -text
